# Virtual environment
.venv/

# Caching & Linters
.ruff_cache/
__pycache__/
*.pyc

# Build artifacts
build/
dist/
*.spec

# OS files
.DS_Store
Thumbs.db

# User data & credentials (important to prevent leaking OAuth tokens)
.colab-cli/
.config/
credentials.json
token.json
oauth_code.txt
storage/
.env
.env.*

# Signing keys
*.jks
*.keystore
release_notes.md
.zcode/
# Update-config payload: written locally, never published from a dev commit.
# The app reads version.json from a URL, so a stray 2.x entry tells every
# installed client to update for a release that is not live yet.
version.json

# Throwaway harnesses and probes. These are scratch files written while
# reproducing a bug headlessly; they are never meant to be committed, and 1700
# lines of them had accumulated once. Anything matching these names is garbage.
debug_*.py
harness_*.py
probe_*.py
scratch_*.py
